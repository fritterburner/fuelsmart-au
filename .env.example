# Upstash Redis (get from upstash.com after creating a free database)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QLD FPD API
QLD_FPD_API_TOKEN=

# NSW FuelCheck API (apply at api.nsw.gov.au)
NSW_FUEL_API_KEY=
NSW_FUEL_API_SECRET=

# Cron secret (generate a random string for production)
CRON_SECRET=

# OpenRouteService — fallback routing provider when the public OSRM demo
# server is down. Sign up at openrouteservice.org/dev/#/signup for a free key
# (2,000 requests/day on the evaluation tier). Optional — if blank, OSRM is the
# only provider and outages surface to the user.
OPENROUTESERVICE_API_KEY=

# --- National coverage (added 2026-06-15) ---
# VIC Fair Fuel Open Data API ("Servo Saver"), Service Victoria. Spec (v1.0,
# Oct 2025) is public and confirmed; only the key is pending. Set once your
# API Consumer ID is approved — the VIC fetcher stays dormant until this is
# present. Auth uses this value as the `x-consumer-id` header.
VIC_SERVO_SAVER_API_KEY=
# Optional override — defaults to https://api.fuel.service.vic.gov.au/open-data/v1
# (GET /fuel/prices, /fuel/reference-data/brands). Only set this if Service
# Victoria documents a different base URL.
VIC_SERVO_SAVER_URL=

# SA Fuel Pricing Information Scheme (Informed Sources FPDAPI — same vendor
# family as QLD). Set once you are an authorised data publisher; the SA
# fetcher stays dormant until SA_FPIS_API_TOKEN is present. Auth header is
# `Authorization: FPDAPI SubscriberToken=<token>`.
SA_FPIS_API_TOKEN=
# Optional override — defaults to
# https://fppdirectapi-prod.safuelpricinginformation.com.au (an unverified
# guess by analogy with QLD's host; confirm once SA docs/key arrive).
SA_FPIS_URL=
# SA's Informed Sources tenant id. QLD's id (21) is CONFIRMED WRONG for SA —
# the real value is unknown until the key/docs arrive. Kept as a placeholder
# default so the fetcher still runs (and self-defends via a bounding-box
# check); override here once known. See docs/go-live-sa-vic.md for how to
# discover it via GetCountryGeographicRegions.
SA_FPIS_COUNTRY_ID=21
# Geography level for the sites/prices queries. 3 = state-level (confirmed).
SA_FPIS_GEOREGION_LEVEL=3
# SA's statewide region id at that level — unknown; QLD's statewide
# convention (1) is a better-grounded default than the old guess of 4, but is
# still unverified for SA specifically. Override once known.
SA_FPIS_GEOREGION_ID=1

# Bearer secret protecting GET /api/usage/report (the SA aggregate usage report).
USAGE_REPORT_SECRET=

# Bearer secret for the one-off historical backfill endpoint
# (GET /api/admin/backfill-history). Set it, run the backfill, then delete the
# route on the next commit — the data persists in Redis.
BACKFILL_SECRET=

# --- Account-free price alerts (Web Push / VAPID) ---
# Generate a keypair once with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is sent to the browser (safe to expose — it's
# the *public* half); VAPID_PRIVATE_KEY must stay server-side only.
# These three vars must also be set in Vercel (Project Settings > Environment
# Variables) for every environment (Production/Preview/Development) that
# should be able to send push notifications — the cron refresh route and the
# /api/alerts route both read them.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services can use to reach you about this VAPID
# identity if something's wrong (e.g. sending too fast). Must be a mailto: or
# https: URI, e.g. mailto:you@example.com
VAPID_SUBJECT=
